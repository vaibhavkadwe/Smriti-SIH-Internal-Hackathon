{"nodes": [{"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_phase11_compliance_pass", "label": "Phase 11: DPDP Compliance Pass", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Input-independent backend pass: close access-control gaps, wire read-audit on health-data reads, consent-scope (purpose-limitation) gates, column-level AES-256 encryption at the service layer, retention/deletion + 30-day-grace jobs, and a sync-queue consumer. Consent posture decided strict (403)."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_phase12_hardening", "label": "Phase 12: Production Hardening", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CORS whitelist via CORS_ORIGINS, Redis-backed rate limiting (100 req/min/IP \u2014 first real Redis use), strict env secrets with fail-fast on placeholders, GitHub Actions CI booting a Postgres service for alembic upgrade + smoke_e2e, and an OWASP-ish pass (bandit, dependency scan)."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_phase13_live_services", "label": "Phase 13: Live External Services (Bhashini + Claude)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Flip the Bhashini provider off mock with a real key (ASR/TTS/NMT on NER-language audio); set ANTHROPIC_API_KEY for non-fallback companion replies + RAG answer synthesis with citations; integration test gate skips when keys absent."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_sync_queue_consumer", "label": "Sync-queue consumer (outbox -> encrypted SymptomLog)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Current /sync is an inert outbox \u2014 process_sync_batch writes sync_queue rows and marks them synced immediately with nothing consuming them. Phase 11 adds a consumer to drain sync_queue and materialize offline_symptom payloads into encrypted SymptomLog rows (respecting retry_count/last_error)."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_rag_pipeline", "label": "RAG pipeline (chunk -> embed -> pgvector -> Claude)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Overlap chunking -> embeddings -> retrieval (cosine + min_similarity) -> Claude-grounded cited answer with disclaimer. Currently heuristic md5-weighted-TF vectors stored in a JSON column; Phase 14 moves to a real multilingual embedding model (e5-small vs text-embedding-3-small) and pgvector vector(N) + HNSW index (migration 0002). Claude has no embeddings API."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_access_control_gaps", "label": "Access-control gaps (reminders/dashboard/companion)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verified gaps: GET /reminders/patients/{id}/events, GET /reminders/schedules/{id}, and GET /dashboard/patients/{id}/summary accept any authenticated user with no ownership/link check; companion chat allows any non-patient role without an active link. Fix by promoting _can_view_patient from patients.py to a shared dependency."}, {"id": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_column_encryption", "label": "Column-level AES-256 encryption at rest (unwired)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "EncryptionService (Fernet/AES-256) exists but SymptomLog.notes and MedicalDocument.extracted_text are stored plaintext despite the 'encrypted at rest' comment. Phase 11 routes them through encrypt on write / decrypt on read at the service layer."}], "edges": [{"source": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_rag_pipeline", "target": "docker_compose_db", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_05_remaining_roadmap_to_mvp_phase12_hardening", "target": "docker_compose_redis", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "weight": 1.0}, {"source": "mobile_pubspec_eldercare_mobile", "target": "docker_compose_backend", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "weight": 1.0}, {"source": "dashboard_pubspec_eldercare_dashboard", "target": "docker_compose_backend", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/superpowers/plans/2026-09-05-remaining-roadmap-to-mvp.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_09_04_phase1_scaffold_data_models_offline_first_sync", "target": "docs_superpowers_plans_2